# Public hostname routed to the VM (used by Caddy)
SITE_DOMAIN=art.example.com

# Admin authentication
ADMIN_PASSWORD=replace-with-a-long-private-password
SESSION_SECRET=replace-with-at-least-32-random-bytes

# Narrow D1 gateway
D1_GATEWAY_URL=https://nibonobu-d1-gateway.prasethsokha.workers.dev
D1_GATEWAY_SECRET=replace-with-the-same-gateway-secret

# R2 S3-compatible access
R2_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=replace-with-r2-access-key-id
R2_SECRET_ACCESS_KEY=replace-with-r2-secret-access-key
R2_BUCKET=sp-test-bucket
